# Server port (Cloud Run injects PORT=8080 automatically)
PORT=8080

# Shared bearer token for Shortcuts & PWA sync (generate a long random string)
INBOX_TOKEN=replace-with-strong-random-token

# DeepSeek API configuration (leave blank or use mock in local offline tests)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Comma-separated allowed browser Origins (e.g. https://<your-github-user>.github.io)
ALLOWED_ORIGINS=
ALLOW_LOCALHOST_ORIGINS=true

# Storage adapter: "firestore" (production) | "memory" (local development/tests)
STORAGE_MODE=memory
FIRESTORE_COLLECTION_PREFIX=

# Timezone used to resolve fallback occurredAt date (prevents UTC midnight day-shift)
DEFAULT_TIMEZONE=Asia/Shanghai
